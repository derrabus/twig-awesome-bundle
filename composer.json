{
    "name": "derrabus/twig-awesome-bundle",
    "type": "symfony-bundle",
    "description": "Inline FontAwesome icons into Twig templates.",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander M. Turek",
            "email": "me@derrabus.de"
        }
    ],
    "require": {
        "php": ">= 8.4",
        "composer-runtime-api": "^2.1",
        "fortawesome/font-awesome": "^7.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.21 || ^4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.24",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2.12",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^13.3.2",
        "symfony/event-dispatcher-contracts": "^3.7",
        "symfony/framework-bundle": "^8.1",
        "symfony/translation-contracts": "^3.7",
        "symfony/twig-bundle": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Rabus\\TwigAwesomeBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rabus\\TwigAwesomeBundle\\": "tests"
        }
    }
}
