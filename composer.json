{
    "name": "derrabus/twig-awesome-bundle",
    "type": "symfony-bundle",
    "description": "Inline FontAwesome icons into Twig templates.",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander M. Turek",
            "email": "me@derrabus.de"
        }
    ],
    "require": {
        "php": ">= 8.2",
        "composer-runtime-api": "^2.1",
        "fortawesome/font-awesome": "^6.6",
        "symfony/dependency-injection": "^7.2 || ^8",
        "symfony/deprecation-contracts": "^2.5 || ^3",
        "symfony/filesystem": "^7.2 || ^8",
        "symfony/http-kernel": "^7.2 || ^8",
        "twig/twig": "^3.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1.11",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^11.5.15",
        "symfony/framework-bundle": "^7.2 || ^8",
        "symfony/twig-bundle": "^7.2 || ^8"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Rabus\\TwigAwesomeBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rabus\\TwigAwesomeBundle\\": "tests"
        }
    }
}
